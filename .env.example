# ===== hajimi-web 配置样例：复制为 .env 并按需修改 =====
MIRROR_DOMAIN=hajimi.example.com
MIRROR_PORT=8322
MIRROR_CACHE=./cache
HAJIMI_PWD=change-me-to-a-strong-password
UPSTREAM_PROXY=http://127.0.0.1:7890
FIREFOX_PROFILE=/home/admin/.mozilla/firefox-gemini

# 直连入口（可选）
# DIRECT_TLS_PORT=8322
# DIRECT_TLS_CERT=certs/fullchain.pem
# DIRECT_TLS_KEY=certs/privkey.pem
