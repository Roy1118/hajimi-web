# ===== hajimi-web 配置样例：复制为 .env 并按需修改 =====
MIRROR_DOMAIN=hajimi.example.com
MIRROR_PORT=8324
MIRROR_CACHE=./cache
HAJIMI_PWD=change-me-to-a-strong-password
UPSTREAM_PROXY=http://127.0.0.1:7890
FIREFOX_PROFILE=/home/admin/.mozilla/firefox-gemini

# 可选：第二套账号口令与独立浏览器 profile（互不回落）
# HAJIMI_ALT_PWD=another-strong-password
# MIRROR_ALT_PROFILE=/home/admin/.mozilla/firefox-gemini-alt

# 内存缓存与监控（可选，以下为推荐高配值）
# MIRROR_MEM_CACHE_MB=192
# MIRROR_MEM_CACHE_ENTRY_KB=12288
# MIRROR_MEM_CACHE_ENTRIES=2048
# MIRROR_STATS_INTERVAL=300

# 直连入口（可选）
# DIRECT_TLS_PORT=8322
# DIRECT_TLS_CERT=certs/fullchain.pem
# DIRECT_TLS_KEY=certs/privkey.pem
